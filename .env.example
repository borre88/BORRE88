# Stringa di connessione al database Postgres.
# In locale (Postgres installato a mano):
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/nutriapp"
# In produzione, usa la connection string fornita dal tuo provider Postgres
# (Neon, Supabase, Railway, ...). Se il provider offre una versione "pooled"
# per ambienti serverless (es. Neon/Supabase), preferisci quella.
DATABASE_URL="postgresql://postgres:password@localhost:5432/nutriapp"

# Valore casuale per firmare le sessioni: genera con `openssl rand -base64 32`
AUTH_SECRET=""

# Credenziali del primo account amministratore (il nutrizionista).
# Cambia la password dopo il primo accesso.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="ChangeMe123!"
